{
  "name": "fashion-fit",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor packaging for the Fashion Fit static web app",
  "scripts": {
    "build": "node scripts/build-mobile.mjs",
    "generate:assets": "node scripts/generate-native-assets.mjs",
    "build:mobile": "npm run build && cap sync && npm run generate:assets",
    "cap:sync": "npm run build:mobile",
    "android": "cap open android",
    "ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
